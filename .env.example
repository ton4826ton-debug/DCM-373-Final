# Copy this file to server/.env and fill in ONE of the keys below.
# The chatbot works without any key too (simple keyword fallback),
# but answers are much better with a real AI key.
# Priority if more than one is set: Gemini > Anthropic > OpenAI

# Option A: Google Gemini (recommended - free tier available)
GEMINI_API_KEY=
# "gemini-flash-latest" auto-points to the newest Flash model, so it keeps
# working even after Google retires older model names (e.g. 2.0 Flash was
# shut down). Pin a specific version instead if you want stability, e.g.
# gemini-3.8-flash - check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest

# Option B: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Option C: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=3000
